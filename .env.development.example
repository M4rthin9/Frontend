# ── Development deployment (dev branch → dev.ccc-frontend.pages.dev) ──
#
# These are BUILD-TIME variables. Vite inlines every VITE_* value into the
# bundle during `vite build`, so they must be set as *build* environment
# variables on the Cloudflare Pages **Preview** environment — Pages *runtime*
# variables do nothing for a static SPA.
#
# If VITE_API_BASE is unset, src/lib/api/client.ts silently falls back to the
# PRODUCTION worker. That is the single easiest way to get this wrong: check
# the Network tab and confirm requests go to ccc-backend-dev.
#
# Copy to .env.local for local development against the dev backend.

VITE_API_BASE=https://ccc-backend-dev.pongsinbas.workers.dev

# Cloudflare's official Turnstile *test* site key — always passes, never shows
# a challenge. Pairs with the always-passing test secret set on the dev worker
# (`wrangler secret put TURNSTILE_SECRET --env development`). Never use these
# in production.
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA
